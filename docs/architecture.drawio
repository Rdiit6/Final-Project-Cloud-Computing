        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    users[\&quot;Users&lt;br/&gt;Borrowers - read only&lt;br/&gt;Lab staff - admin, IP restricted\&quot;]\n    dev[\&quot;Developer&lt;br/&gt;git push / docker push\&quot;]\n\n    subgraph AWS[\&quot;AWS Cloud - us-east-1\&quot;]\n        subgraph VPC[\&quot;LabVPC\&quot;]\n            subgraph PUB[\&quot;Public Subnet 1 + Public Subnet 2\&quot;]\n                alb[\&quot;Application Load Balancer&lt;br/&gt;microservicesLB&lt;br/&gt;HTTP:80 production / HTTP:8080 test&lt;br/&gt;Rule: /admin/* + source IP /32 -&gt; employee\&quot;]\n                tgc[\&quot;Target groups&lt;br/&gt;customer-tg-one / customer-tg-two\&quot;]\n                tge[\&quot;Target groups&lt;br/&gt;employee-tg-one / employee-tg-two\&quot;]\n                subgraph ECS[\&quot;Amazon ECS Fargate cluster&lt;br/&gt;microservices-serverlesscluster\&quot;]\n                    svcc[\&quot;ECS service: customer-microservice&lt;br/&gt;Fargate tasks - read only - port 8080\&quot;]\n                    svce[\&quot;ECS service: employee-microservice&lt;br/&gt;Fargate tasks - CRUD /admin - port 8080\&quot;]\n                end\n                c9[\&quot;AWS Cloud9 IDE&lt;br/&gt;MicroservicesIDE - EC2 t3.small&lt;br/&gt;Docker build and test\&quot;]\n                mono[\&quot;EC2 MonolithicAppServer&lt;br/&gt;original monolith\&quot;]\n            end\n            subgraph PRIV[\&quot;Private DB subnets\&quot;]\n                rds[(\&quot;Amazon RDS MySQL&lt;br/&gt;supplierdb - db.t3.micro&lt;br/&gt;Not publicly accessible\&quot;)]\n            end\n        end\n\n        subgraph CICD[\&quot;CI/CD - managed services\&quot;]\n            ccm[\&quot;CodeCommit repo&lt;br/&gt;microservices - app source\&quot;]\n            ccd[\&quot;CodeCommit repo&lt;br/&gt;deployment - taskdef + appspec\&quot;]\n            ecr[\&quot;Amazon ECR&lt;br/&gt;customer / employee images\&quot;]\n            cp[\&quot;AWS CodePipeline&lt;br/&gt;update-customer-microservice&lt;br/&gt;update-employee-microservice\&quot;]\n            cd[\&quot;AWS CodeDeploy&lt;br/&gt;app: microservices&lt;br/&gt;Blue/Green ECSAllAtOnce\&quot;]\n        end\n\n        iam[\&quot;IAM roles&lt;br/&gt;PipelineRole - pipeline + task execution&lt;br/&gt;DeployRole - CodeDeploy\&quot;]\n        cw[\&quot;Amazon CloudWatch Logs&lt;br/&gt;log group: awslogs-capstone\&quot;]\n    end\n\n    users --&gt;|\&quot;1. HTTP request\&quot;| alb\n    alb --&gt;|\&quot;2a. default path\&quot;| tgc\n    alb --&gt;|\&quot;2b. /admin/* from allowed IP\&quot;| tge\n    tgc --&gt; svcc\n    tge --&gt; svce\n    svcc --&gt;|\&quot;3. SQL read - 3306\&quot;| rds\n    svce --&gt;|\&quot;3. SQL read/write - 3306\&quot;| rds\n\n    dev --&gt; c9\n    c9 --&gt;|\&quot;A. git push\&quot;| ccm\n    c9 --&gt;|\&quot;A. git push\&quot;| ccd\n    c9 --&gt;|\&quot;B. docker push\&quot;| ecr\n    ccd --&gt;|\&quot;C. triggers\&quot;| cp\n    ecr --&gt;|\&quot;C. new image triggers\&quot;| cp\n    cp --&gt;|\&quot;D. deploy\&quot;| cd\n    cd --&gt;|\&quot;E. blue/green task sets\&quot;| svcc\n    cd --&gt;|\&quot;E. blue/green task sets\&quot;| svce\n    cd -.-&gt;|\&quot;swaps listener rules\&quot;| alb\n    ecr -.-&gt;|\&quot;image pull\&quot;| svcc\n    ecr -.-&gt;|\&quot;image pull\&quot;| svce\n\n    iam -.-&gt; cp\n    iam -.-&gt; cd\n    iam -.-&gt; ECS\n    svcc -.-&gt;|\&quot;logs\&quot;| cw\n    svce -.-&gt;|\&quot;logs\&quot;| cw\n    mono -.-&gt;|\&quot;same DB\&quot;| rds&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eOS9q3ZfZ7r30cMgFSLz-1">
